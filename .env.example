# Public contract address, only after a reviewed Arc Testnet deployment.
VITE_MICROCOVER_ADDRESS=

# Public evidence API base. Loopback demo only; never put credentials in this URL.
VITE_EVIDENCE_API_URL=http://127.0.0.1:8787

# Server-only: choose persistent storage outside every checkout; keys/payloads stay there.
MICROCOVER_EVIDENCE_HOME=
# Public Phase 3 address for read-only activation; leave unset until human deployment.
MICROCOVER_EVIDENCE_CONTRACT=
MICROCOVER_EVIDENCE_PORT=8787

# Server-only Arkiv RPC access key. Never expose it through VITE_ or wallet chain URLs.
ARKIV_ACCESS_KEY=

# Deployment credentials, if used later, belong only in local/host secret settings.
# Never prefix private keys, Circle API keys, entity secrets or RPC proxy tokens with VITE_.
